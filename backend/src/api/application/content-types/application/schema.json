{
  "kind": "collectionType",
  "collectionName": "applications",
  "info": {
    "singularName": "application",
    "pluralName": "applications",
    "displayName": "Application"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    },
    "coverMessage": {
      "type": "text"
    },
    "resume": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "videos",
        "audios",
        "files"
      ]
    },
    "career": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::career.career",
      "inversedBy": "applications"
    },
    "statuses": {
      "type": "enumeration",
      "enum": [
        "new",
        "reviewing",
        "shortlisted",
        "rejected",
        "hired"
      ]
    },
    "submittedAt": {
      "type": "datetime"
    }
  }
}
