{
  "kind": "collectionType",
  "collectionName": "contact_submissions",
  "info": {
    "singularName": "contact-submission",
    "pluralName": "contact-submissions",
    "displayName": "Contact Submission",
    "description": "Enquiries sent through the website contact form."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "company": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "statuses": {
      "type": "enumeration",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "closed"
      ],
      "default": "new"
    },
    "notified": {
      "type": "boolean",
      "default": false
    },
    "submittedAt": {
      "type": "datetime"
    }
  }
}
